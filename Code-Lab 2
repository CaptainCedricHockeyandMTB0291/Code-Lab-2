function renderBm(){
$('bmCode').textContent=bm[$('bmType').value];
}

$('bmType').onchange=renderBm;
$('copyBm').onclick=()=>copy(bm[$('bmType').value]);
renderBm();

const demo=[
'[DEMO] Loading fictional modules...',
'[DEMO] Checking imaginary subsystem: OK',
'[DEMO] Rendering terminal interface...',
'[DEMO] No external connection attempted.',
'[DEMO] Simulation sequence complete.'
];

let di=0;

document.addEventListener('keydown',e=>{
if(['Shift','Control','Alt','Meta','Tab'].includes(e.key)||
!$('hacker').classList.contains('active'))return;

$('terminal').textContent+='\n'+demo[di++%demo.length];
});

$('clearTerminal').onclick=()=>{
di=0;
$('terminal').textContent="CEDRIC'S CODE LAB // SIMULATION\nREADY — PRESS ANY KEY...";
};

// Matrix effect is decorative and limited to this page.
const canvas=$('matrix');
const ctx=canvas.getContext('2d');
let raf=null,drops=[];

function sizeCanvas(){
canvas.width=innerWidth;
canvas.height=innerHeight;
drops=Array(Math.ceil(innerWidth/16)).fill(1);
}

function frame(){
ctx.fillStyle='rgba(0,0,0,.08)';
ctx.fillRect(0,0,canvas.width,canvas.height);
ctx.fillStyle='#35ed78';
ctx.font='15px monospace';

drops.forEach((y,i)=>{
ctx.fillText(String.fromCharCode(33+Math.random()*90),i*16,y*16);
if(y*16>innerHeight&&Math.random()>.975)drops[i]=0;
drops[i]++;
});

raf=requestAnimationFrame(frame);
}

$('matrixStart').onclick=()=>{
if(raf)return;
canvas.style.display='block';
sizeCanvas();
frame();
$('matrixStatus').textContent='Running — press Stop to close.';
};

$('matrixStop').onclick=()=>{
if(raf)cancelAnimationFrame(raf);
raf=null;
canvas.style.display='none';
ctx.clearRect(0,0,canvas.width,canvas.height);
$('matrixStatus').textContent='Stopped.';
};

addEventListener('resize',()=>{
if(raf)sizeCanvas();
});
</script>
